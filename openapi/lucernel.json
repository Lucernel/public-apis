                "schema": {
                  "type": "object",
                  "properties": {
                    "version": {
                      "type": "string",
                      "enum": [
                        "1"
                      ]
                    },
                    "date": {
                      "type": "string",
                      "format": "date",
                      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                      "description": "A real calendar date in YYYY-MM-DD. Birth dates: 1900 through today (UTC)."
                    },
                    "reference": {
                      "type": "string"
                    },
                    "text": {
                      "type": "string"
                    },
                    "translation": {
                      "type": "string",
                      "enum": [
                        "World English Bible"
                      ]
                    },
                    "source": {
                      "type": "string",
                      "format": "uri"
                    }
                  },
                  "required": [
                    "version",
                    "date",
                    "reference",
                    "text",
                    "translation",
                    "source"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
