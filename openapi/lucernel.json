{
  "openapi": "3.0.3",
  "info": {
    "title": "Lucernel Public Tools API",
    "version": "1.0.0",
    "description": "Daily verses from the public-domain World English Bible dataset used by the website.\n\nNo API key. Per client: burst 10, refill 30/minute. Shared service capacity: burst 20, refill 10/second; at most 8 in flight. Honor Retry-After on HTTP 429/503. POST JSON: maximum 2048 bytes. No automatic retries. Dates are sent in POST bodies, never URL parameters.",
    "contact": {
      "name": "Lucernel",
      "url": "https://lucernel.com"
    }
  },
  "servers": [
    {
      "url": "https://lucernel.com"
    }
  ],
  "security": [],
  "externalDocs": {
    "description": "Usage and limits",
    "url": "https://github.com/Lucernel/public-apis/blob/main/docs/lucernel.md"
  },
  "paths": {
    "/api/public/v1/daily-verse": {
      "get": {
        "operationId": "verse",
        "summary": "Daily Bible verse",
        "description": "Read the World English Bible verse for a calendar date; defaults to today in UTC.",
