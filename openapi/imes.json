  "info": {
    "title": "Istruzione Messina Public Tools API",
    "version": "1.0.0",
    "description": "A small date-based angel-number calculator. This is a symbolic calculation, not a factual prediction.\n\nNo API key. Per client: burst 10, refill 30/minute. Shared service capacity: burst 20, refill 10/second; at most 8 in flight. Honor Retry-After on HTTP 429/503. POST JSON: maximum 2048 bytes. No automatic retries. Dates are sent in POST bodies, never URL parameters.",
    "contact": {
      "name": "Istruzione Messina",
      "url": "https://istruzionemessina.it"
    }
  },
  "servers": [
    {
      "url": "https://istruzionemessina.it"
    }
  ],
  "security": [],
  "externalDocs": {
    "description": "Usage and limits",
    "url": "https://github.com/Lucernel/public-apis/blob/main/docs/imes.md"
  },
