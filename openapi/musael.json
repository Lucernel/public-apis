                        "knight",
                        "sci-fi-planet",
                        "alien",
                        "starship"
                      ]
                    },
                    "seed": {
                      "type": "integer"
                    },
                    "names": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 20,
                      "items": {
                        "type": "string"
                      }
                    },
                    "source": {
                      "type": "string",
                      "format": "uri"
                    }
                  },
                  "required": [
                    "version",
                    "kind",
                    "seed",
                    "names",
                    "source"
